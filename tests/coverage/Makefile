SRC := $(PWD)/../src/

GCNOS := $(wildcard ../src/*.gcno) # generated by build process with code cov.
GCDAS := $(GCNOS:.gcno=.gcda) # generated by running instrumented code
GCOVS := $(GCNOS:.gcno=.gcov-filt) # generated by analysis of gcda

ifeq ($(GCNOS),)
	echo "Please configure valgrind4hpc with --enable-code-coverage and rebuild"
	exit 1
endif

.PHONY: coverage

coverage: coverage.xml

coverage.xml: $(GCDAS)
	gcovr -r $(SRC) -x --object-directory=$(SRC) > coverage.xml

$(GCDAS):
	cd ../function && python run_tests.py
	cd ../cc_valgrind4hpc_shmem.ar/ && $(MAKE) clean && $(MAKE) check

%.gcov-filt : %.gcna
	gcov -abcfu $< | c++filt > $@

sonar-scan:
	sonar-scanner
	@echo
	@echo View SonarQube results at:
	@echo https://sonar.us.cray.com/dashboard?id=valgrind4hpc

clean:
	rm -f $(GCDAS) $(GCOVS)
