#!/usr/bin/env expect

set USER [lindex $argv 0]
set HOST [lindex $argv 1]
set PASSWORD $env(SSHPASS)
set COMMAND [lindex $argv 2]

# Uncomment for debug output
# exp_internal 1

spawn ssh -t $USER@$HOST $COMMAND
set timeout 30
expect {
    "continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send -- "$PASSWORD\r"
        exp_continue
    }
    "Password:" {
        send -- "$PASSWORD\r"
        exp_continue
    }
    eof {
        send_user "all done\n"
    }
    timeout {
        send_user "timed out\n"
        exit -1
    }
}
lassign [wait] pid spawnid os_error_flag value
exit $value
