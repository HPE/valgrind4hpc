diff --git a/rpmbuild/SOURCES/get_package_data b/rpmbuild/SOURCES/get_package_data
new file mode 100755
index 0000000..8779983
--- /dev/null
+++ b/rpmbuild/SOURCES/get_package_data
@@ -0,0 +1,40 @@
+#!/bin/sh
+basedir=$(dirname $0)
+
+. ${basedir}/../../release_versioning
+
+crayversion=
+branch=
+if [ ! -z ${build_number} ]; then
+ # This version was built from a non-release branch
+  crayversion="${major:-0}.${minor:-0}.${revision}.${build_number}"
+  branch="master"
+else
+  # This version was built from a release branch
+  crayversion="${major:-0}.${minor:-0}.${revision}"
+  branch="release"
+fi
+
+cdstsupportversionmin=$(echo ${CRAY_CDST_SUPPORT_VERSION} | awk -F . '{ print $1"."$2 }')
+tmpver=$(echo ${CRAY_CDST_SUPPORT_VERSION} | awk -F . '{ print $1 }')
+cdstsupportversionmax=$(($tmpver+1))
+
+ctiversionmin=$(echo ${CTI_VERSION} | awk -F . '{ print $1"."$2 }')
+tmpver=$(echo ${CTI_VERSION} | awk -F . '{ print $1 }')
+ctiversionmax=$(($tmpver+1))
+
+arguments=$(getopt -o csmtx --long crayversion,cdstversionmin,cdstversionmax,ctiversionmin,ctiversionmax,branch -n ${0} -- "$@")
+
+if [ $? != 0 ] ; then echo "Terminating..." >&2 ; exit 1 ; fi
+
+while true ; do
+    case "$1" in
+        -c|--crayversion) echo "${crayversion}" ; shift ;;
+        -s|--cdstversionmin) echo "${cdstsupportversionmin}" ; shift ;;
+        -m|--cdstversionmax) echo "${cdstsupportversionmax}" ; shift ;;
+        -t|--ctiversionmin) echo "${ctiversionmin}" ; shift ;;
+        -x|--ctiversionmax) echo "${ctiversionmax}" ; shift ;;
+        -b|--branch) echo "${branch}" ; shift ;;
+        *) break ;;
+    esac
+done
diff --git a/rpmbuild/SOURCES/release_info.template b/rpmbuild/SOURCES/release_info.template
new file mode 100644
index 0000000..cfe3e7b
--- /dev/null
+++ b/rpmbuild/SOURCES/release_info.template
@@ -0,0 +1,58 @@
+MRNET <VERSION>:
+======================================
+
+Release Date:
+--------------
+  <RELEASE_DATE>
+
+
+Product Description:
+--------------------
+  MRNet is a customizable, high-performance software infrastructure for
+  building scalable tools and applications.  It supports efficient 
+  multicast and data aggregation functionality using a tree of processes 
+  between the tool's front-end and back-ends.  MRNet-based tools may use 
+  these internal processes to distribute many important tool activities, 
+  for example to reduce data analysis time and keep tool front-end loads 
+  manageable.
+
+  MRNet-based tool components communicate across logical channels called
+  streams. At MRNet internal processes, filters are bound to these streams to
+  synchronize and aggregate dataflows. Using filters, MRNet can efficiently
+  compute averages, sums, and other more complex aggregations and analyses
+  on tool data. MRNet also supports facilities that allow tool developers
+  dynamically load new tool-specific filters into the system.  
+
+Purpose:
+---------
+  Initial release of stand-alone cray-mrnet package.
+
+Product and OS Dependencies:
+-----------------------------
+  The MRNET <VERSION> is supported on the following Cray systems:
+    - HPE/Cray XC systems with CLE 7.0 or later
+    - HPE/Cray CS systems with CentOS 8.0 or later & RHEL 8.3 or later
+    - HPE/Cray Shasta systems with SLES 15 service pack 1 or later
+    - HPE Apollo systems with Slurm and Centos 8.0 or later
+    - Baymax systems with Centos 8.0 or later
+
+  Product Dependencies:
+    - Cray cray-cti rpm installed
+    - Cray cray-cdst-support rpm installed
+
+Documentation:
+---------------
+
+Installation instructions:
+--------------------------
+
+   Installation instructions for <ARCH>:
+   =============================================
+      rpm -ivh cray-mrnet-<VERSION>-<RELEASE>.<ARCH>.rpm
+
+      To make MRNET <VERSION> the default version of MRNET, execute:
+      <CRAY_PREFIX>/admin-pe/set_default_files/set_default_cray-mrnet_<VERSION>
+
+
+Certain components, files or programs contained within this package or product are
+<COPYRIGHT>
diff --git a/rpmbuild/SOURCES/set_default/set_default_template b/rpmbuild/SOURCES/set_default/set_default_template
new file mode 100644
